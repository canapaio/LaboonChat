{
  "providers": {
    "ollama": {
      "enabled": true,
      "url": "http://localhost:11434",
      "model": "codellama:7b",
      "timeout": 30,
      "priority": 1,
      "description": "Analisi locale con Ollama - privacy massima"
    },
    "openai": {
      "enabled": false,
      "api_key": "",
      "model": "gpt-4",
      "timeout": 20,
      "priority": 2,
      "description": "OpenAI GPT-4 - analisi avanzata (richiede API key)"
    },
    "claude": {
      "enabled": false,
      "api_key": "",
      "model": "claude-3-sonnet-20240229",
      "timeout": 25,
      "priority": 3,
      "description": "Anthropic Claude - eccellente per sicurezza (richiede API key)"
    },
    "gemini": {
      "enabled": false,
      "api_key": "",
      "model": "gemini-pro",
      "timeout": 20,
      "priority": 4,
      "description": "Google Gemini - analisi rapida (richiede API key)"
    }
  },
  "analysis": {
    "cache_duration_hours": 24,
    "min_confidence_threshold": 0.7,
    "enable_static_analysis": true,
    "max_file_size_kb": 500,
    "parallel_analysis": false,
    "detailed_logging": true
  },
  "security_thresholds": {
    "safe": {
      "min_confidence": 0.8,
      "max_issues": 0,
      "auto_approve": true
    },
    "suspicious": {
      "min_confidence": 0.6,
      "max_issues": 3,
      "require_user_confirmation": true
    },
    "dangerous": {
      "min_confidence": 0.7,
      "max_issues": 10,
      "block_installation": true
    },
    "malicious": {
      "min_confidence": 0.8,
      "permanent_block": true,
      "report_to_network": true
    }
  },
  "fallback_behavior": {
    "no_ai_available": "suspicious",
    "analysis_timeout": "suspicious",
    "parse_error": "dangerous",
    "network_error": "use_cache_or_block"
  },
  "integration": {
    "simple_security_integration": true,
    "update_trust_scores": true,
    "share_analysis_results": false,
    "anonymous_reporting": true
  }
}